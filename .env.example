# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/payroll_db?schema=public"

# Redis (BullMQ Queues)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Object Storage (MinIO / S3)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_NAME="payroll-payslips"

# API & Web
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/trpc"

# Authentication
AUTH_COOKIE_NAME="sweldoph_session"
AUTH_SESSION_TTL_HOURS=8

# One-time administrator bootstrap (used only by `pnpm auth:bootstrap`)
BOOTSTRAP_ORGANIZATION_ID="replace-with-an-existing-organization-uuid"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_NAME="Payroll Administrator"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-password-of-12+-characters"
