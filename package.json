{
  "name": "payroll",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "db:start": "powershell -ExecutionPolicy Bypass -File scripts/start-local-db.ps1",
    "db:seed": "pnpm --filter @workspace/db db:seed && pnpm --filter @workspace/db exec tsx prisma/seed-demo-users.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "auth:bootstrap": "pnpm build && pnpm --filter @workspace/api auth:bootstrap:prod",
    "db:migrate:deploy": "pnpm --filter @workspace/db db:migrate:deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @workspace/api test:e2e",
    "test:smoke": "pnpm build && pnpm --filter @workspace/api test:smoke",
    "typecheck": "turbo typecheck",
    "record:showcase": "node scripts/record-showcase.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.11.4",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
