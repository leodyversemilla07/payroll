{
  "name": "payroll",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "auth:bootstrap": "pnpm build && pnpm --filter @workspace/api auth:bootstrap:prod",
    "db:migrate:deploy": "pnpm --filter @workspace/db db:migrate:deploy",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @workspace/api test:e2e",
    "test:smoke": "pnpm build && pnpm --filter @workspace/api test:smoke",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@workspace/typescript-config": "workspace:*",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0"
  }
}
